# ──────────────────────────────────────────────
# Base de données PostgreSQL
# Railway : Add → Database → PostgreSQL
# La variable DATABASE_URL est injectée automatiquement
# ──────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────
# URL du serveur Socket.io (production uniquement)
# Laisser vide en dev (connexion à localhost automatique)
# Exemple : https://skyjo-production.up.railway.app
# ──────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=
